{
  "id": "pms_dalvdm",
  "version": 1,
  "name": "打驴动漫",
  "type": "animeSource",
  "responseType": "json",
  "useWebview": false,
  "site": {
    "domain": "www.dalvdm.cc",
    "baseUrl": "https://www.dalvdm.cc",
    "mirrors": [
      { "name": "主站", "domain": "www.dalvdm.cc", "baseUrl": "https://www.dalvdm.cc" }
    ]
  },
  "parser": {
    "type": "hybrid",
    "overrides": {
      "latest": { "type": "builtin" },
      "search": { "type": "builtin" },
      "detail": { "type": "builtin" },
      "episodes": { "type": "builtin" },
      "video": { "type": "builtin" }
    }
  },
  "routes": {
    "latest": { "url": "/index.php/ajax/data/?mid=1&page={page}&limit=20", "method": "get", "responseType": "json" },
    "search": { "url": "/index.php/ajax/data/?mid=1&wd={keyword}&page={page}&limit=20", "method": "get", "responseType": "json" },
    "detail": { "url": "/index.php/ajax/data/?mid=1&ids={id}", "method": "get", "responseType": "json" },
    "episodes": { "url": "/index.php/vod/detail/id/{id}.html", "method": "get", "responseType": "html" },
    "video": { "url": "{url}", "method": "get", "responseType": "html" }
  },
  "selectors": {
    "list": "$.list",
    "id": "$.vod_id",
    "title": "$.vod_name",
    "cover": "$.vod_pic",
    "detail": {
      "id": "$.list[0].vod_id",
      "title": "$.list[0].vod_name",
      "cover": "$.list[0].vod_pic",
      "description": "$.list[0].vod_content",
      "director": "$.list[0].vod_director",
      "actors": "$.list[0].vod_actor",
      "status": "$.list[0].vod_remarks",
      "year": "$.list[0].vod_year",
      "tags": "$.list[0].vod_tag",
      "detailUrl": "$.list[0].detail_link"
    },
    "episodes": "ul.anthology-list-play li a, a[href*='/vod/play/']",
    "video": "//video/@src"
  },
  "category": {
    "dynamicCategories": false,
    "categoryEntries": [
      { "id": "all", "title": "全部" },
      { "id": "1", "title": "动漫" },
      { "id": "2", "title": "剧场版" },
      { "id": "3", "title": "国产" },
      { "id": "4", "title": "日韩" },
      { "id": "5", "title": "欧美" }
    ]
  },
  "homeSections": [
    { "id": "latest", "title": "最新更新", "route": "latest", "style": "grid", "limit": 18, "more": true }
  ],
  "stealthMode": true,
  "antiHotlinking": { "referer": "https://www.dalvdm.cc" },
  "enabled": true,
  "enabledExplore": true
}
